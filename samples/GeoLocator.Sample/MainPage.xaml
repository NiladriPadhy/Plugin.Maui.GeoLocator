<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeoLocator.Sample.MainPage"
             Title="Geo Locator">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="MAUI Geo Locator"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="On-demand location, tracking, reverse geocoding, and logging."
                   TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />

            <HorizontalStackLayout Spacing="8">
                <Label x:Name="StatusLabel" Text="Ready" VerticalOptions="Center" />
                <Label x:Name="ServicesLabel" Text="Services: unknown" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Button Text="Current location" Clicked="OnGetCurrentLocationClicked" />
                <Button Grid.Column="1" Text="Last known" Clicked="OnGetLastKnownClicked" />
                <Button Grid.Row="1" Text="Start tracking" Clicked="OnStartTrackingClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Stop tracking" Clicked="OnStopTrackingClicked" />
            </Grid>

            <Button Text="Reverse geocode last location" Clicked="OnReverseGeocodeClicked" />

            <HorizontalStackLayout Spacing="12">
                <Switch x:Name="LoggingSwitch" IsToggled="True" Toggled="OnLoggingToggled" />
                <Label Text="Enable logging" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Location" FontAttributes="Bold" />
            <Label x:Name="LocationLabel" Text="No location yet." LineBreakMode="WordWrap" />

            <Label Text="Address" FontAttributes="Bold" />
            <Label x:Name="AddressLabel" Text="No address yet." LineBreakMode="WordWrap" />

            <Label Text="Log" FontAttributes="Bold" />
            <Border Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                    StrokeThickness="1"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                <Label x:Name="LogLabel"
                       Text="Logging is enabled."
                       FontFamily="Courier New"
                       FontSize="12"
                       LineBreakMode="WordWrap" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
