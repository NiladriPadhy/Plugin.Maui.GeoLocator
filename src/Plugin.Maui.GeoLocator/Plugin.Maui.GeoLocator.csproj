<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<RootNamespace>Plugin.Maui.GeoLocator</RootNamespace>
		<AssemblyName>Plugin.Maui.GeoLocator</AssemblyName>
		<PackageId>Plugin.Maui.GeoLocator</PackageId>
		<Title>.NET MAUI GeoLocator — GPS, tracking, reverse geocoding</Title>
		<Description>On-demand location, start/stop tracking, reverse geocoding, and optional logging for .NET MAUI on Android and iOS.</Description>
		<PackageTags>dotnet-maui;maui;maui-plugin;maui-utilities;cross-platform;android;ios;nuget;mauiessentials;geolocation;gps;location;tracking;reverse-geocoding;geocoding</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/NiladriPadhy/Plugin.Maui.GeoLocator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NiladriPadhy/Plugin.Maui.GeoLocator</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Authors>MauiEssentials</Authors>
		<Company>MauiEssentials</Company>
		<Copyright>Copyright © MauiEssentials</Copyright>
		<Version>1.0.6</Version>
    <PackageReleaseNotes>Reliability fixes for races, dispose/lifecycle, and lock or session correctness.</PackageReleaseNotes>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
		<IsPackable>true</IsPackable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.GeoLocator.Tests" />
	</ItemGroup>

</Project>
